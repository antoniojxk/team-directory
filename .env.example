# Copy to .env for local development. Replace every placeholder before starting.
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql+psycopg://team:replace-with-local-database-password@localhost:15432/team_directory
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_VIEWER_PASSWORD=replace-with-viewer-demo-password
DEMO_HR_PASSWORD=replace-with-hr-demo-password
ACCESS_TOKEN_MINUTES=30
DB_POOL_SIZE=2
PORT=8080
